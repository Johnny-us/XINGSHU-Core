{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:candidate:context-bridge:context-registration-proposal",
  "$comment": "Public candidate contract with disabled semantics. governance_effect=none; authorization_effect=none; activation_effect=none.",
  "title": "XINGSHU Context Bridge Candidate Registration Proposal",
  "description": "Portable public-candidate contract for suggestion-only registration advice. A Proposal binds an exact Candidate input but does not authorize, register, activate, establish trusted identity, or create Source access.",
  "type": "object",
  "required": [
    "schema_version",
    "object_kind",
    "proposal_id",
    "candidate_id",
    "candidate_fingerprint",
    "suggested_canonical_name",
    "suggested_source_entry_points",
    "suggested_allowed_clients",
    "suggested_access_scope",
    "suggested_freshness_policy",
    "suggested_provenance_policy",
    "retrieval_hint"
  ],
  "properties": {
    "schema_version": {
      "const": "context-bridge-candidate",
      "description": "Candidate contract identity only; not a release, adoption, or activation version."
    },
    "object_kind": {
      "const": "context_registration_proposal"
    },
    "proposal_id": {
      "$ref": "#/$defs/object_id"
    },
    "candidate_id": {
      "$ref": "#/$defs/object_id",
      "description": "Identity of the Candidate input."
    },
    "candidate_fingerprint": {
      "$ref": "#/$defs/sha256_fingerprint",
      "description": "Fingerprint linkage to the exact Candidate input reviewed by a future deterministic chain validator; it is not authorization."
    },
    "suggested_canonical_name": {
      "$ref": "#/$defs/human_name",
      "description": "Suggested human-readable registered name only."
    },
    "suggested_aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/human_name"
      },
      "description": "Optional suggested aliases only."
    },
    "suggested_source_entry_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/opaque_locator"
      },
      "description": "Ordered, explicit, opaque retrieval-entry suggestions. Array order is significant and must be preserved; implementations must not sort, auto-deduplicate, silently truncate, or treat these suggestions as final authority."
    },
    "suggested_allowed_clients": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/client_id"
      },
      "description": "Suggested client identifiers only. An empty array is a valid deny-all suggestion and no value creates client authority."
    },
    "suggested_access_scope": {
      "type": "string",
      "enum": [
        "private",
        "restricted",
        "shared"
      ],
      "description": "Suggested access scope only."
    },
    "suggested_freshness_policy": {
      "type": "string",
      "enum": [
        "immutable",
        "manual_verification",
        "verify_before_use"
      ],
      "description": "Suggested freshness policy only."
    },
    "suggested_provenance_policy": {
      "type": "string",
      "enum": [
        "locator_only",
        "locator_and_verification",
        "locator_and_fingerprint"
      ],
      "description": "Suggested provenance policy only."
    },
    "retrieval_hint": {
      "$ref": "#/$defs/retrieval_hint",
      "description": "Non-authoritative operational hint for later review."
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC 3339 timestamp for the verified observation on which this Proposal relies. It is evidence linkage only and does not authorize the Proposal, create a Registered Context Reference, let an AI mint authority, or bypass deterministic validation and Human Authorization."
    },
    "verification_evidence_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/object_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Opaque pointer to the verified observation evidence on which this suggestion relies. It is not authorization, final authority, registration evidence, or permission to bypass deterministic validation and Human Authorization."
    }
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "last_verified_at"
            ]
          },
          {
            "required": [
              "verification_evidence_id"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "last_verified_at",
        "verification_evidence_id"
      ],
      "properties": {
        "last_verified_at": {
          "type": "null"
        },
        "verification_evidence_id": {
          "type": "null"
        }
      }
    },
    {
      "required": [
        "last_verified_at",
        "verification_evidence_id"
      ],
      "properties": {
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_evidence_id": {
          "$ref": "#/$defs/object_id"
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "human_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "opaque_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "retrieval_hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "client_id": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        {
          "not": {
            "enum": [
              "*",
              "all",
              "any"
            ]
          }
        }
      ]
    }
  }
}
