{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:candidate:context-bridge:runtime-binding",
  "title": "Runtime Binding Candidate",
  "description": "Provider-neutral structural contract for an owner-controlled binding between a trusted client profile and an accepted Context Reference. Real binding values remain in the Personal Instance. This object is generated by a trusted runtime control plane, not authored or overridden by an ordinary caller, model prompt, tool argument, client handshake, or environment self-report. Schema validity does not prove cross-object identity, authorize use, or activate runtime wiring.",
  "$comment": "schema_version=context-bridge-candidate; governance_effect=none; authorization_effect=none; activation_effect=none",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_kind",
    "binding_id",
    "trusted_client_profile_id",
    "trusted_client_profile_fingerprint",
    "reference_id",
    "reference_fingerprint",
    "bound_access_scope",
    "bound_entry_points",
    "allowed_operations",
    "transport_binding_id",
    "transport_class",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "context-bridge-candidate"
    },
    "object_kind": {
      "const": "runtime_binding"
    },
    "binding_id": {
      "$ref": "#/$defs/stable_identifier"
    },
    "trusted_client_profile_id": {
      "$ref": "#/$defs/stable_identifier"
    },
    "trusted_client_profile_fingerprint": {
      "$ref": "#/$defs/sha256_fingerprint"
    },
    "reference_id": {
      "$ref": "#/$defs/stable_identifier"
    },
    "reference_fingerprint": {
      "$ref": "#/$defs/sha256_fingerprint"
    },
    "bound_access_scope": {
      "type": "string",
      "enum": [
        "private",
        "restricted",
        "shared"
      ],
      "description": "Exact access_scope copied from the fingerprint-linked accepted Reference. It cannot broaden that Reference; deterministic cross-object validation is required."
    },
    "bound_entry_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_wildcard_locator"
      },
      "description": "Exact bounded entry points inherited from the accepted Reference. Runtime validation must verify the subset relationship; schema validation alone cannot."
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "get_reference",
          "resolve_context"
        ]
      },
      "description": "Closed operation set for this binding. It contains no wildcard and cannot create Source authority."
    },
    "transport_binding_id": {
      "$ref": "#/$defs/stable_identifier"
    },
    "transport_class": {
      "type": "string",
      "enum": [
        "in_process",
        "stdio",
        "loopback_http",
        "tool_api"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "opaque_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "non_wildcard_locator": {
      "allOf": [
        {
          "$ref": "#/$defs/opaque_locator"
        },
        {
          "not": {
            "enum": [
              "*",
              "all",
              "any",
              "ALL",
              "ANY",
              "All",
              "Any",
              "/**"
            ]
          }
        }
      ]
    },
    "sha256_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
