{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:candidate:context-bridge:trusted-client-profile",
  "title": "Trusted Client Profile Candidate",
  "description": "Provider-neutral public-safe structural contract for an owner-controlled trusted client identity profile. Real profile values and storage remain in the Personal Instance and originate through an owner-controlled local/bootstrap flow. A client/model/tool/prompt/handshake/environment self-report cannot establish this identity. A valid document does not authenticate a client, grant Source or Reference authority, authorize an operation, activate a runtime binding, or create governance effect.",
  "$comment": "schema_version=context-bridge-candidate; governance_effect=none; authorization_effect=none; activation_effect=none",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_kind",
    "profile_id",
    "client_id",
    "profile_version",
    "identity_origin",
    "client_class",
    "profile_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "context-bridge-candidate"
    },
    "object_kind": {
      "const": "trusted_client_profile"
    },
    "profile_id": {
      "$ref": "#/$defs/stable_identifier"
    },
    "client_id": {
      "$ref": "#/$defs/non_wildcard_identifier"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "identity_origin": {
      "const": "owner_controlled",
      "description": "The identity record originates through an owner-controlled local/bootstrap flow. This assertion is not proven by schema validation or by a caller, prompt, tool argument, handshake, model, or environment self-report."
    },
    "client_class": {
      "type": "string",
      "enum": [
        "ai_agent",
        "local_service",
        "local_tool"
      ]
    },
    "profile_status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "description": "Profile lifecycle state only. Active does not mean authorized for any Source, Reference, scope, operation, transport, or runtime."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "revoked_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_status": {
            "const": "revoked"
          }
        },
        "required": [
          "profile_status"
        ]
      },
      "then": {
        "required": [
          "revoked_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "revoked_at"
          ]
        }
      }
    }
  ],
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "non_wildcard_identifier": {
      "allOf": [
        {
          "$ref": "#/$defs/stable_identifier"
        },
        {
          "not": {
            "enum": [
              "*",
              "all",
              "any",
              "ALL",
              "ANY",
              "All",
              "Any"
            ]
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
