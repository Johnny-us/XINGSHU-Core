{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:v0.2.1:state-separation",
  "title": "XINGSHU Core v0.2.1 State Separation",
  "oneOf": [
    {"$ref": "#/$defs/state_record"},
    {"$ref": "#/$defs/state_transition"}
  ],
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
      "additionalProperties": {"type": "object"}
    },
    "subject_ref": {
      "type": "object",
      "required": ["subject_id", "subject_type"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "subject_type": {"type": "string", "minLength": 1},
        "subject_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["scope_type"],
      "properties": {
        "scope_type": {"enum": ["task", "project", "domain", "instance", "provider", "device_class", "global", "other"]},
        "scope_ref": {"type": "string", "minLength": 1},
        "environment_class": {"type": "string", "minLength": 1},
        "valid_time_window": {"type": "object"}
      },
      "additionalProperties": false
    },
    "review_trigger": {
      "type": "object",
      "required": ["trigger_type", "condition"],
      "properties": {
        "trigger_type": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "condition_result": {
      "type": "object",
      "required": ["condition_id", "result"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "unknown"]}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["error_code", "message", "safe_next_state"],
      "properties": {
        "error_code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "safe_next_state": {"enum": ["needs_more_evidence", "needs_authorization", "blocked", "deny", "stopped", "rollback_required"]}
      },
      "additionalProperties": false
    },
    "state_record": {
      "type": "object",
      "required": ["schema_version", "record_type", "record_id", "created_at", "state_kind", "state_domain", "state_namespace", "state_value", "subject_ref", "scope", "validation_state", "basis_refs", "review_triggers"],
      "properties": {
        "schema_version": {"const": "0.2.1"},
        "record_type": {"const": "state_record"},
        "record_id": {"type": "string", "pattern": "^[ -~]{1,128}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "extensions": {"$ref": "#/$defs/extensions"},
        "state_kind": {"enum": ["source", "runtime", "observed", "decision"]},
        "state_domain": {"enum": ["configuration", "execution", "evidence", "asset", "workflow", "other"]},
        "state_namespace": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "state_value": {"type": "string", "minLength": 1},
        "subject_ref": {"$ref": "#/$defs/subject_ref"},
        "scope": {"$ref": "#/$defs/scope"},
        "validation_state": {"enum": ["unverified", "partially_verified", "verified", "stably_verified", "stale", "failed", "unknown", "not_applicable"]},
        "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_triggers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review_trigger"}},
        "supersedes_ref": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "declared_at": {"type": "string", "format": "date-time"},
        "declaration_type": {"enum": ["desired", "planned", "reported", "input", "other"]},
        "runtime_ref": {"type": "string", "minLength": 1},
        "sampled_at": {"type": "string", "format": "date-time"},
        "runtime_readback": {
          "type": "object",
          "required": ["method_ref", "result_code"],
          "properties": {"method_ref": {"type": "string"}, "result_code": {"type": "string"}, "integrity_ref": {"type": "string"}},
          "additionalProperties": false
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "claim_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "freshness": {
          "type": "object",
          "required": ["evaluated_at"],
          "properties": {"evaluated_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}},
          "additionalProperties": false
        },
        "decision_outcome": {"enum": ["allow", "deny", "defer", "needs_review"]},
        "governance_basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "authorization_status": {"enum": ["valid", "required", "missing", "stale", "out_of_scope", "not_required", "unknown"]},
        "authorization_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision_effect": {"const": "classification_only"}
      },
      "allOf": [
        {"if": {"properties": {"state_kind": {"const": "source"}}}, "then": {"required": ["source_ref", "declared_at", "declaration_type"], "not": {"anyOf": [{"required": ["runtime_readback"]}, {"required": ["evidence_refs"]}, {"required": ["decision_outcome"]}]}}},
        {"if": {"properties": {"state_kind": {"const": "runtime"}}}, "then": {"required": ["runtime_ref", "sampled_at", "runtime_readback"], "not": {"required": ["decision_outcome"]}}},
        {"if": {"properties": {"state_kind": {"const": "observed"}}}, "then": {"required": ["observed_at", "evidence_refs", "claim_refs", "freshness"], "properties": {"evidence_refs": {"minItems": 1}}}},
        {"if": {"properties": {"state_kind": {"const": "decision"}}}, "then": {"required": ["decision_outcome", "governance_basis_refs", "evidence_refs", "authorization_status", "authorization_refs", "decision_effect"], "allOf": [{"if": {"properties": {"authorization_status": {"const": "valid"}}}, "then": {"properties": {"authorization_refs": {"minItems": 1}}}, "else": {"properties": {"authorization_refs": {"maxItems": 0}}}}]}}
      ],
      "additionalProperties": false
    },
    "state_transition": {
      "type": "object",
      "required": ["schema_version", "record_type", "record_id", "created_at", "from_state_ref", "to_state_ref", "transition_type", "condition_results", "evidence_refs", "authorization_refs", "occurred_at", "transition_result"],
      "properties": {
        "schema_version": {"const": "0.2.1"},
        "record_type": {"const": "state_transition"},
        "record_id": {"type": "string", "pattern": "^[ -~]{1,128}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "extensions": {"$ref": "#/$defs/extensions"},
        "from_state_ref": {"type": "string", "minLength": 1},
        "to_state_ref": {"type": "string", "minLength": 1},
        "transition_type": {"enum": ["declare", "load", "execute", "observe", "verify", "decide", "invalidate", "correct", "supersede"]},
        "assessment_ref": {"type": "string", "minLength": 1},
        "condition_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition_result"}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authorization_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "occurred_at": {"type": "string", "format": "date-time"},
        "transition_result": {"enum": ["accepted", "rejected", "partial"]},
        "error": {"$ref": "#/$defs/error"}
      },
      "allOf": [
        {"if": {"properties": {"transition_result": {"enum": ["rejected", "partial"]}}}, "then": {"required": ["error"]}},
        {"if": {"properties": {"transition_type": {"const": "execute"}}}, "then": {"required": ["assessment_ref"]}}
      ],
      "additionalProperties": false
    }
  }
}
