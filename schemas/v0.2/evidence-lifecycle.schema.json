{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:v0.2:evidence-lifecycle",
  "title": "XINGSHU Core v0.2 Evidence Lifecycle Metadata",
  "type": "object",
  "required": ["schema_version", "record_type", "record_id", "created_at", "evidence_id", "subject_ref", "validation_scope", "provenance", "observed_at", "validation_method", "evidence_state", "freshness", "privacy_classification", "payload_handling", "review_triggers", "relationships", "claim_refs"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "record_type": {"const": "evidence_metadata"},
    "record_id": {"type": "string", "pattern": "^[ -~]{1,128}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!(payload|raw_payload|content|body|secret|credential|token|cookie|local_path|email|account_id|device_id|personal_identity|chat_text)$)[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
      "additionalProperties": {"type": "object"}
    },
    "evidence_id": {"type": "string", "minLength": 1},
    "subject_ref": {"$ref": "#/$defs/subject_ref"},
    "validation_scope": {"$ref": "#/$defs/validation_scope"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "observed_at": {"type": "string", "format": "date-time"},
    "validation_method": {
      "type": "object",
      "required": ["method_id", "method_version", "result"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "method_version": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "partial", "inconclusive", "not_run"]}
      },
      "additionalProperties": false
    },
    "evidence_state": {"enum": ["current", "stale", "superseded", "corrected", "historical", "invalid", "unknown"]},
    "freshness": {
      "type": "object",
      "required": ["evaluated_at"],
      "properties": {
        "evaluated_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "review_after": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "privacy_classification": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]},
    "payload_handling": {"enum": ["not_collected", "external_private", "redacted", "synthetic_public"]},
    "review_triggers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review_trigger"}},
    "relationships": {"$ref": "#/$defs/relationships"},
    "claim_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity_ref": {"type": "string", "minLength": 1},
    "license_provenance": {
      "type": "object",
      "required": ["source_class", "usage_basis"],
      "properties": {"source_class": {"type": "string"}, "usage_basis": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "subject_ref": {
      "type": "object",
      "required": ["subject_id", "subject_type"],
      "properties": {"subject_id": {"type": "string"}, "subject_type": {"type": "string"}, "subject_version": {"type": "string"}},
      "additionalProperties": false
    },
    "validation_scope": {
      "type": "object",
      "required": ["subject_identity", "claim_refs", "state_domains", "environment_class", "version_constraints", "time_window", "scope_limitations"],
      "properties": {
        "subject_identity": {"$ref": "#/$defs/subject_ref"},
        "claim_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment_class": {"enum": ["isolated_test", "local_runtime", "remote_service", "document_review", "other"]},
        "version_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "time_window": {
          "type": "object",
          "required": ["start"],
          "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}},
          "additionalProperties": false
        },
        "scope_limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_type", "producer_type", "source_ref", "collected_at", "collection_method_ref"],
      "properties": {
        "source_type": {"enum": ["runtime_readback", "test_result", "document", "service_response", "human_confirmation", "professional_verification", "derived", "other"]},
        "producer_type": {"enum": ["human", "agent", "runtime", "service", "tool", "mixed", "unknown"]},
        "source_ref": {"type": "string"},
        "collected_at": {"type": "string", "format": "date-time"},
        "collection_method_ref": {"type": "string"},
        "producer_version": {"type": "string"},
        "derivation_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "review_trigger": {
      "type": "object",
      "required": ["trigger_type", "condition"],
      "properties": {
        "trigger_type": {"enum": ["time_elapsed", "subject_changed", "version_changed", "environment_changed", "governance_changed", "new_conflicting_evidence", "method_invalidated", "scope_changed", "manual_review_required"]},
        "condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "object",
      "required": ["supersedes", "superseded_by", "corrects", "corrected_by", "derived_from"],
      "properties": {
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "superseded_by": {"type": "array", "items": {"type": "string"}},
        "corrects": {"type": "array", "items": {"type": "string"}},
        "corrected_by": {"type": "array", "items": {"type": "string"}},
        "derived_from": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
