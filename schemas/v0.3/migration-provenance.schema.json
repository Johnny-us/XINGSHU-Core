{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xingshu:core:schema:v0.3:migration-provenance",
  "title": "XINGSHU Core v0.3 Migration Provenance",
  "type": "object",
  "required": [
    "schema_version", "record_type", "record_id", "created_at", "migration_id",
    "target_topic_ref", "source_inventory", "mappings", "omitted_items", "source_unchanged",
    "source_unchanged_evidence_refs", "migration_state", "runtime_validation_state",
    "unresolved_conflicts", "relationships", "privacy", "authorization_effect",
    "governance_effect", "activation_state"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "record_type": {"const": "migration_provenance"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "migration_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_topic_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_item"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}},
    "omitted_items": {"type": "array", "items": {"$ref": "#/$defs/omitted_item"}},
    "source_unchanged": {"type": "boolean"},
    "source_unchanged_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "migration_state": {"enum": ["not_migrated", "in_progress", "migrated", "needs_review", "not_applicable", "unknown"]},
    "runtime_validation_state": {"enum": ["not_run", "pending_verification", "verified", "failed", "stale", "unknown"]},
    "unresolved_conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "relationships": {"$ref": "#/$defs/relationships"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "authorization_effect": {"const": "none"},
    "governance_effect": {"const": "none"},
    "activation_state": {"const": "not_active"}
  },
  "allOf": [
    {
      "if": {"properties": {"source_unchanged": {"const": true}}},
      "then": {"properties": {"source_unchanged_evidence_refs": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "source_item": {
      "type": "object",
      "required": ["source_id", "source_class", "source_ref", "captured_at"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "source_class": {"enum": ["original_source", "formal_knowledge", "derived_view", "historical_record", "external_source", "other"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "captured_at": {"type": "string", "format": "date-time"},
        "integrity": {
          "type": "object",
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {"enum": ["sha256", "sha512", "other"]},
            "digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{16,128}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["source_id", "target_object_ref", "target_section", "decision", "reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_object_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "target_section": {"type": "string", "minLength": 1, "maxLength": 256},
        "decision": {"enum": ["copied", "merged", "deduplicated", "summarized"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "omitted_item": {
      "type": "object",
      "required": ["source_id", "reason_code", "reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason_code": {"enum": ["duplicate", "obsolete", "out_of_scope", "privacy_boundary", "unverified", "unsafe_payload", "other"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "covered_by_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["conflict_id", "source_refs", "affected_claim_refs", "conflict_type", "safe_next_state"],
      "properties": {
        "conflict_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "affected_claim_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "conflict_type": {"enum": ["version", "platform", "scope", "conclusion", "source_priority", "other"]},
        "safe_next_state": {"const": "needs_review"}
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "object",
      "required": ["target_main_ref", "appendix_refs", "provenance_refs", "evidence_refs", "supersedes", "superseded_by"],
      "properties": {
        "target_main_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "appendix_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "superseded_by": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["payload_handling", "sensitive_data_included"],
      "properties": {
        "payload_handling": {"enum": ["metadata_only", "external_private", "redacted", "synthetic_public"]},
        "sensitive_data_included": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
